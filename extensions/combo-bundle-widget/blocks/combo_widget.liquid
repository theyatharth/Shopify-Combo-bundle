{% assign bundle_products = product.metafields.custom.combo_products.value %}

{% comment %} 
  Dynamically read the discount percentage chosen by the admin from a metafield.
  Falls back to 15% if not defined yet.
{% endcomment %}
{% assign discount_percentage = product.metafields.custom.bundle_discount.value | default: 15 %}

{% if bundle_products != blank %}
  
  {% comment %} 1. Calculate the cumulative original price {% endcomment %}
  {% assign total_original_price = product.price %}
  {% for item in bundle_products %}
    {% assign total_original_price = total_original_price | plus: item.price %}
  {% endfor %}

  {% comment %} 2. Calculate savings and final bundle pricing {% endcomment %}
  {% assign savings = total_original_price | times: discount_percentage | divided_by: 100 %}
  {% assign discounted_price = total_original_price | minus: savings %}

  <div class="combo-bundle-container" style="margin: 20px 0; padding: 20px; border: 1px solid #e1e1e1; border-radius: 8px; background-color: #fafafa;">
    
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
      <h3 style="margin: 0; font-size: 1.2rem; font-weight: 700; color: #222;">Frequently Bought Together</h3>
      <span style="background-color: #e32c2b; color: #fff; padding: 4px 10px; font-size: 12px; font-weight: bold; border-radius: 12px; text-transform: uppercase;">
        Save {{ discount_percentage }}% Off
      </span>
    </div>
    
    <div id="combo-items-data" data-main-id="{{ product.selected_or_first_available_variant.id }}">
      {% for item in bundle_products %}
         <input type="hidden" class="combo-item-id" value="{{ item.selected_or_first_available_variant.id }}">
      {% endfor %}
    </div>
    
    <div class="combo-products-flex" style="display: flex; gap: 10px; align-items: center; overflow-x: auto; padding-bottom: 10px;">
      
      <div class="product-card" style="text-align: center; flex: 1; min-width: 110px;">
        <img src="{{ product.featured_image | img_url: '150x150', crop: 'center' }}" alt="{{ product.title | escape }}" style="max-width: 100%; border-radius: 6px; border: 1px solid #eee;">
        <p style="font-size: 13px; margin: 8px 0 4px; line-height: 1.2; color: #444;">{{ product.title | truncate: 25 }}</p>
        <span style="font-weight: 600; font-size: 13px; color: #666;">{{ product.price | money }}</span>
      </div>

      <div style="font-size: 20px; font-weight: bold; color: #aaa; padding: 0 2px;">+</div>

      {% for item in bundle_products %}
        <div class="product-card" style="text-align: center; flex: 1; min-width: 110px;">
          <img src="{{ item.featured_image | img_url: '150x150', crop: 'center' }}" alt="{{ item.title | escape }}" style="max-width: 100%; border-radius: 6px; border: 1px solid #eee;">
          <p style="font-size: 13px; margin: 8px 0 4px; line-height: 1.2; color: #444;">{{ item.title | truncate: 25 }}</p>
          <span style="font-weight: 600; font-size: 13px; color: #666;">{{ item.price | money }}</span>
        </div>
        
        {% unless forloop.last %}
          <div style="font-size: 20px; font-weight: bold; color: #aaa; padding: 0 2px;">+</div>
        {% endunless %}
      {% endfor %}
      
    </div>

    <div style="margin-top: 15px; padding-top: 15px; border-top: 1px dashed #ddd; display: flex; flex-direction: column; align-items: flex-end; gap: 2px;">
      <div style="font-size: 14px; color: #666;">
        Total Reg. Price: <span style="text-decoration: line-through; margin-left: 5px;">{{ total_original_price | money }}</span>
      </div>
      <div style="font-size: 14px; color: #2e7d32; font-weight: 600;">
        Your Instant Savings: <span>-{{ savings | money }}</span>
      </div>
      <div style="font-size: 18px; font-weight: bold; color: #222; margin-top: 4px;">
        Combo Price: <span style="color: #e32c2b; font-size: 20px; margin-left: 5px;">{{ discounted_price | money }}</span>
      </div>
    </div>

    <button id="add-combo-btn" type="button" style="margin-top: 15px; width: 100%; padding: 14px; background-color: #2c2c2c; color: #ffffff; border: none; border-radius: 4px; font-weight: bold; cursor: pointer; text-transform: uppercase; letter-spacing: 0.5px; font-size: 14px; transition: background 0.2s ease;">
      Add Combo to Cart
    </button>
  </div>

  <script>
    document.getElementById('add-combo-btn').addEventListener('click', function() {
      const btn = this;
      const originalText = btn.innerText;
      btn.innerText = "Adding Bundle...";
      btn.disabled = true;

      // Gather the variant IDs
      const mainId = document.getElementById('combo-items-data').getAttribute('data-main-id');
      const comboInputs = document.querySelectorAll('.combo-item-id');
      
      let itemsToAdd = [{ id: parseInt(mainId), quantity: 1 }];
      comboInputs.forEach(input => {
        if(input.value) {
          itemsToAdd.push({ id: parseInt(input.value), quantity: 1 });
        }
      });

      console.log("Sending these items to Shopify:", itemsToAdd); // Check your console!

      // Use absolute path for cart
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: itemsToAdd })
      })
      .then(async (response) => {
        // If Shopify throws a 422 (or any error), parse the exact reason
        if (!response.ok) {
          const errorData = await response.json();
          throw new Error(errorData.description || 'Unknown cart error');
        }
        return response.json();
      })
      .then(() => {
        btn.innerText = "Bundle Added!";
        window.location.href = '/cart'; 
      })
      .catch(error => {
        console.error('Add to cart mistake:', error);
        
        // POPUP THE EXACT SHOPIFY ERROR
        alert("Shopify Blocked This: " + error.message); 
        
        btn.innerText = "Error - Try Again";
        btn.disabled = false;
        setTimeout(() => { btn.innerText = originalText; }, 3000);
      });
    });
  </script>
{% endif %}

{% schema %}
{
  "name": "Combo Bundle Widget",
  "target": "section",
  "settings": []
}
{% endschema %}