     assign byob_variant = product.selected_or_first_available_variant
     # Full image gallery for the popup carousel — every image on the product,
     # not just the featured one.
     capture byob_images_json
      echo '['
      for byob_img in product.images
       unless forloop.first
        echo ','
       endunless
       echo byob_img | image_url: width: 800 | json
      endfor
      echo ']'
     endcapture
     # Raw description HTML, escaped for safe embedding in the attribute.
     # The browser decodes it back to the original HTML when JS reads the
     # attribute, so the popup can render it with innerHTML exactly like
     # the product page renders {{ product.description }} — same
     # paragraphs, same bold "Product Specifications" labels, etc.
    %}
    {% if product.available %}
    <div class="byob-product-card"
      data-byob-product
      data-byob-product-id="{{ product.id }}"
      data-byob-variant-id="{{ byob_variant.id }}"
      data-byob-price="{{ byob_variant.price }}"
      data-byob-compare-price="{% if byob_variant.compare_at_price > byob_variant.price %}{{ byob_variant.compare_at_price }}{% endif %}"
      data-byob-full-title="{{ product.title | escape }}"
      data-byob-description="{{ product.description | escape }}"
      data-byob-image-large="{{ product.featured_image | image_url: width: 800 }}"
      data-byob-images="{{ byob_images_json | escape }}"
