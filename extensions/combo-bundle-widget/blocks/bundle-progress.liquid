 .byob-modal-qty-stepper span { min-width: 38px; text-align: center; font-size: 14px; font-weight: 700; color: var(--byob-text); }
 .byob-modal-add-btn { flex: 1 1 auto; height: 46px; padding: 0 14px; border-radius: 8px; font-size: 13.5px; font-weight: 800; letter-spacing: 0.01em; cursor: pointer; transition: all 0.18s ease; box-sizing: border-box; background: var(--byob-green); border: 1.5px solid var(--byob-green); color: #fff; }
 .byob-modal-add-btn:hover:not(:disabled):not(.is-added) { filter: brightness(1.1); }
 .byob-modal-add-btn.is-added { background: var(--byob-white); border-color: var(--byob-green); color: var(--byob-green); }
 .byob-modal-add-btn:disabled { background: #F1F5F9; border-color: var(--byob-card-border); color: var(--byob-grey-dark); cursor: not-allowed; }
 .byob-modal-qty-note { display: flex; align-items: flex-start; gap: 6px; font-size: 11.5px; color: var(--byob-subtext); margin: 0 0 10px; }
 .byob-modal-trust-strip { content-visibility: visible !important; display: flex !important; flex-wrap: nowrap; border: 1px solid #E2E2DA; border-radius: 8px; margin: 4px 0 16px; overflow: visible; }
