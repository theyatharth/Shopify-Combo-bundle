  if (!ratingWrap || ratingWrap.querySelector('.byob-modal-areviews-avg')) return;
  var countSpan = ratingWrap.querySelector('span');
  var avgSpan = document.createElement('span');
  avgSpan.className = 'byob-modal-areviews-avg';
