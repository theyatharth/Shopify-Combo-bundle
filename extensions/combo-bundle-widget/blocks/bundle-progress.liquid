 .byob-modal-desc a { color: var(--byob-green); }
 .byob-modal-readmore { display: inline-block; margin-top: 4px; padding: 0; border: none; background: none; color: var(--byob-green); font-size: 13px; font-weight: 700; cursor: pointer; text-decoration: underline; text-underline-offset: 2px; }
 .byob-modal-readmore:hover { opacity: 0.75; }
 .byob-modal-readmore[hidden] { display: none; }
  .byob-modal-bundle-box { background: var(--byob-green-light); border: 1px solid color-mix(in srgb, var(--byob-green) 14%, transparent); border-radius: 12px; padding: 16px 16px 14px; margin-bottom: 18px; }
 .byob-modal-bundle-head { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
 .byob-modal-bundle-icon { flex-shrink: 0; width: 38px; height: 38px; border-radius: 50%; background: var(--byob-green); display: flex; align-items: center; justify-content: center; }
 .byob-modal-bundle-icon svg { width: 19px; height: 19px; }
 .byob-modal-bundle-title { font-size: 14.5px; font-weight: 800; color: var(--byob-text); }
 .byob-modal-bundle-count { font-size: 12px; font-weight: 700; color: var(--byob-subtext); }
 .byob-modal-bundle-count span { color: var(--byob-green); }
  .byob-modal-ladder .byob-node-circle { width: 21px; height: 21px; font-size: 9.5px; }
 .byob-modal-ladder .byob-node-label { font-size: 8.5px; }
 .byob-modal-ladder .byob-ladder-track { top: 10px; left: 10px; right: 10px; }
 .byob-modal-ladder .byob-ladder-track-fill { height: 2px; }
 .byob-modal-ladder .byob-node.byob-current .byob-node-circle,
 .byob-modal-ladder .byob-node.byob-maxed .byob-node-circle { box-shadow: 0 0 0 3px var(--byob-green-light); transform: scale(1.1); }
 .byob-modal-bundle-box .byob-node-circle { background: #fff; border-color: color-mix(in srgb, var(--byob-green) 35%, transparent); }
  .byob-modal-actions-row { display: flex; align-items: center; gap: 14px; margin-bottom: 8px; }
 .byob-modal-qty-label { display: block; font-size: 12.5px; font-weight: 700; color: var(--byob-text); margin-bottom: 8px; }
 .byob-modal-qty-stepper { flex-shrink: 0; display: flex; align-items: center; border: 1px solid var(--byob-card-border); border-radius: 8px; overflow: hidden; width: fit-content; }
 .byob-modal-qty-stepper button { width: 38px; height: 44px; border: none; background: #F8FAF9; color: var(--byob-text); font-size: 16px; font-weight: 700; cursor: pointer; line-height: 1; }
