  .byob-modal-trust-label { font-size: 12px; white-space: normal; }
  .byob-modal-trust-sub { font-size: 10px; white-space: normal; }
 }
  .byob-modal-recs { border-top: 1px solid var(--byob-card-border); padding-top: 16px; }
 .byob-modal-recs[hidden] { display: none; }
 .byob-modal-recs-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; margin-bottom: 12px; }
 .byob-modal-recs-head-left { display: flex; align-items: center; gap: 10px; }
 .byob-modal-recs-icon { flex-shrink: 0; width: 34px; height: 34px; border-radius: 50%; background: var(--byob-green-light); color: var(--byob-green); display: flex; align-items: center; justify-content: center; }
 .byob-modal-recs-icon svg { width: 17px; height: 17px; }
 .byob-modal-recs-title { font-size: 14px; font-weight: 800; color: var(--byob-text); }
 .byob-modal-recs-sub { font-size: 11.5px; color: var(--byob-subtext); margin-top: 1px; }
 .byob-modal-recs-seemore { flex-shrink: 0; font-size: 12px; font-weight: 700; color: var(--byob-green); text-decoration: none; white-space: nowrap; }
 .byob-modal-recs-seemore:hover { text-decoration: underline; }
 .byob-modal-recs-track { display: flex; gap: 12px; overflow-x: auto; padding-bottom: 4px; scrollbar-width: thin; }
 .byob-modal-rec-card { flex: 0 0 128px; display: flex; flex-direction: column; gap: 6px; }
 .byob-modal-rec-image { width: 100%; aspect-ratio: 1 / 1; border-radius: 8px; overflow: hidden; background: #F1F5F9; }
 .byob-modal-rec-image img { width: 100%; height: 100%; object-fit: cover; display: block; }
