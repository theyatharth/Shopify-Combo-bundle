{% schema %}
{
  "name": "Floating Bundle Builder",
  "target": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "progress_color",
      "label": "Progress Bar Color",
      "default": "#4a5568"
    }
  ]
}
{% endschema %}

<!-- Load the lightweight Canvas Confetti library -->
<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

<style>
  #byob-sticky-widget {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background-color: {{ block.settings.bg_color }};
    box-shadow: 0 -4px 10px rgba(0,0,0,0.1);
    z-index: 2147483647;
    padding: 16px;
    font-family: inherit;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transform: translateY(100%);
    transition: transform 0.3s ease-in-out;
  }
  
  #byob-sticky-widget.active {
    transform: translateY(0);
  }

  .byob-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 14px;
    font-weight: bold;
    transition: all 0.3s ease;
  }

  /* The Pop-Up Animation for Maximum Discount */
  @keyframes popAndGlow {
    0% { transform: scale(1); color: inherit; }
    50% { transform: scale(1.08); color: #16a34a; }
    100% { transform: scale(1); color: #16a34a; }
  }

  .animate-pop {
    animation: popAndGlow 0.6s ease-out forwards;
  }

  .byob-progress-track {
    width: 100%;
    height: 8px;
    background-color: #e2e8f0;
    border-radius: 4px;
    overflow: hidden;
  }

  .byob-progress-fill {
    height: 100%;
    background-color: {{ block.settings.progress_color }};
    width: 0%;
    transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .byob-main-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  .byob-product-list {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 4px;
  }

  .byob-product-item {
    position: relative;
    width: 48px;
    height: 48px;
    border-radius: 6px;
    border: 1px solid #cbd5e1;
    background-size: cover;
    background-position: center;
    flex-shrink: 0;
    animation: popIn 0.3s ease-out;
  }

  @keyframes popIn {
    0% { transform: scale(0.8); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
  }

  .byob-remove-btn {
    position: absolute;
    top: -6px;
    right: -6px;
    background: #000;
    color: #fff;
    border: none;
    border-radius: 50%;
    width: 18px;
    height: 18px;
    font-size: 14px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .byob-empty-slot {
    width: 48px;
    height: 48px;
    border-radius: 6px;
    border: 1px dashed #cbd5e1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    color: #cbd5e1;
    flex-shrink: 0;
  }

  .byob-pricing {
    text-align: right;
    font-size: 12px;
  }

  .byob-checkout-btn {
    background-color: #556b2f;
    color: white;
    border: none;
    padding: 10px 24px;
    border-radius: 6px;
    font-weight: bold;
    cursor: pointer;
    text-decoration: none;
  }
</style>

<div id="byob-sticky-widget">
  <div class="byob-header">
    <span id="byob-status-msg">Loading...</span>
  </div>
  
  <div class="byob-progress-track">
    <div id="byob-progress-fill" class="byob-progress-fill"></div>
  </div>

  <div class="byob-main-row">
    <div id="byob-product-list" class="byob-product-list">
      <!-- Products injected here via JS -->
    </div>

    <div style="display: flex; align-items: center; gap: 16px;">
      <div class="byob-pricing">
        <div style="font-weight: bold;">Subtotal</div>
        <div id="byob-savings" style="color: #dc2626; font-size: 11px;">Save: ₹0</div>
        <div style="font-size: 14px; font-weight: bold;">
          <span id="byob-final-price">₹0</span> 
          <span id="byob-original-price" style="text-decoration: line-through; color: #94a3b8; font-size: 12px;">₹0</span>
        </div>
      </div>
      <a href="/checkout" class="byob-checkout-btn">CHECKOUT</a>
    </div>
  </div>
</div>

<script>
  const formatMoney = (cents) => '₹' + (cents / 100).toFixed(2);
  let previousQty = null; // State tracker to fire confetti only on tier-ups

  // Function to handle the scaling confetti blasts
  function fireConfetti(tier) {
    if (typeof confetti === 'undefined') return; // Guard clause in case library fails to load

    if (tier === 1) {
      // 10% - Light single blast
      confetti({ particleCount: 50, spread: 60, origin: { y: 0.8 }, zIndex: 2147483648 });
    } else if (tier === 2) {
      // 15% - Medium double blast
      confetti({ particleCount: 80, spread: 80, origin: { x: 0.3, y: 0.8 }, zIndex: 2147483648 });
      setTimeout(() => {
        confetti({ particleCount: 80, spread: 80, origin: { x: 0.7, y: 0.8 }, zIndex: 2147483648 });
      }, 250);
    } else if (tier === 3) {
      // 20% - Massive sustained celebration
      const duration = 2500;
      const end = Date.now() + duration;

      (function frame() {
        confetti({
          particleCount: 5,
          angle: 60,
          spread: 55,
          origin: { x: 0 },
          colors: ['#26ccff', '#a25afd', '#ff5e7e', '#88ff5a', '#fcff42', '#ffa62d', '#ff36ff'],
          zIndex: 2147483648
        });
        confetti({
          particleCount: 5,
          angle: 120,
          spread: 55,
          origin: { x: 1 },
          colors: ['#26ccff', '#a25afd', '#ff5e7e', '#88ff5a', '#fcff42', '#ffa62d', '#ff36ff'],
          zIndex: 2147483648
        });

        if (Date.now() < end) {
          requestAnimationFrame(frame);
        }
      }());
    }
  }

  async function updateBundleUI() {
    try {
      const res = await fetch(window.Shopify.routes.root + 'cart.js');
      const cart = await res.json();
      
      const widget = document.getElementById('byob-sticky-widget');
      const statusMsg = document.getElementById('byob-status-msg');
      const progressFill = document.getElementById('byob-progress-fill');
      const productList = document.getElementById('byob-product-list');
      
      const qty = cart.item_count;
      const originalTotalPrice = cart.items.reduce((sum, item) => sum + item.original_line_price, 0);
      
      let discountPct = 0;
      let width = "0%";
      let msg = "";

      // Remove animation class to re-trigger it if necessary
      statusMsg.classList.remove('animate-pop');

      if (qty === 0) {
        msg = "Add 2 Item(s) to Buy 2 at 10% Off";
        width = "0%";
        widget.classList.remove('active'); 
      } else {
        widget.classList.add('active'); 
        
        if (qty === 1) {
          msg = "Add 1 More Item(s) to Buy 2 at 10% Off";
          width = "50%";
          discountPct = 0;
        } else if (qty === 2) {
          msg = "Buy 2 at 10% Off applied. Add 1 More Item(s) to Buy 3 at 15% Off";
          width = "65%";
          discountPct = 0.10;
          if (previousQty !== null && previousQty < 2) fireConfetti(1);
        } else if (qty === 3) {
          msg = "Buy 3 at 15% Off applied. Add 1 More Item(s) to Buy 4 at 20% Off";
          width = "75%";
          discountPct = 0.15;
          if (previousQty !== null && previousQty < 3) fireConfetti(2);
        } else if (qty >= 4) {
          msg = "🎉 Congratulations you got a whopping 20% off! 🎉";
          width = "100%";
          discountPct = 0.20;
          
          // Trigger CSS Pop Animation on the text
          void statusMsg.offsetWidth; // Trigger DOM reflow to restart animation
          statusMsg.classList.add('animate-pop');

          if (previousQty !== null && previousQty < 4) fireConfetti(3);
        }
      }

      // Update state tracker
      previousQty = qty;

      // Apply UI Updates
      statusMsg.innerText = msg;
      progressFill.style.width = width;

      const savings = originalTotalPrice * discountPct;
      const finalPrice = originalTotalPrice - savings;

      document.getElementById('byob-savings').innerText = `Save: ${formatMoney(savings)}`;
      document.getElementById('byob-final-price').innerText = formatMoney(finalPrice);
      document.getElementById('byob-original-price').innerText = formatMoney(originalTotalPrice);

      // Render Products
      productList.innerHTML = '';
      cart.items.forEach(item => {
        for(let i = 0; i < item.quantity; i++) {
            const itemHTML = `
              <div class="byob-product-item" style="background-image: url('${item.image}')">
                <button class="byob-remove-btn" onclick="removeBundleItem('${item.key}')">-</button>
              </div>
            `;
            productList.insertAdjacentHTML('beforeend', itemHTML);
        }
      });

      // Render Empty Slot
      if (qty < 4) {
         productList.insertAdjacentHTML('beforeend', `<div class="byob-empty-slot">+</div>`);
      }

    } catch (err) {
      console.error('BYOB widget error:', err);
    }
  }

  // Remove Item
  window.removeBundleItem = async function(lineItemKey) {
    try {
      await fetch(window.Shopify.routes.root + 'cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: lineItemKey, quantity: 0 })
      });
      updateBundleUI();
      document.dispatchEvent(new CustomEvent('cart:updated'));
    } catch (err) {
      console.error('Error removing item:', err);
    }
  }

  document.addEventListener('DOMContentLoaded', updateBundleUI);
  
  const originalFetchBYOB = window.fetch;
  window.fetch = async function() {
      const response = await originalFetchBYOB.apply(this, arguments);
      const url = arguments[0];
      if (typeof url === 'string' && (url.includes('/cart/add') || url.includes('/cart/change') || url.includes('/cart/update'))) {
          setTimeout(updateBundleUI, 500); 
      }
      return response;
  };
</script>