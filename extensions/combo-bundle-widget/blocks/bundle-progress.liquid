{% comment %}
  Discount tiers and brand colors come from the combo_bundles.settings shop
  metafield -- the same single source of truth the app's Settings page
  (Phase 2) and the cart-lines discount function (Phase 3) read and write.
  This used to be its own set of block settings here, which could silently
  drift from what checkout actually applied; now there's one place to edit
  them. The literal defaults below only matter if that metafield hasn't
  been created yet (e.g. a merchant hasn't opened Settings), and mirror
  DEFAULT_SETTINGS in app/models/comboBundleSettings.server.js exactly.
{% endcomment %}
{% liquid
 assign byob_collection = collections[block.settings.collection]
 assign byob_max_items = block.settings.max_items | default: 6
 assign cb_settings = shop.metafields.combo_bundles.settings.value
 assign byob_tier_2 = 5
 assign byob_tier_3 = 8
 assign byob_tier_4 = 10
 assign byob_tier_5 = 12
 assign byob_tier_6 = 15
 assign byob_accent = '#1B5E20'
 assign byob_accent_light = '#E8F5E9'
 assign byob_bg = '#FFFFFF'
 if cb_settings != blank
  for tier in cb_settings.tiers
   assign tier_min = tier.min | plus: 0
   if tier_min == 2
    assign byob_tier_2 = tier.pct
   elsif tier_min == 3
    assign byob_tier_3 = tier.pct
   elsif tier_min == 4
    assign byob_tier_4 = tier.pct
   elsif tier_min == 5
    assign byob_tier_5 = tier.pct
   elsif tier_min == 6
    assign byob_tier_6 = tier.pct
   endif
  endfor
  assign cb_accent = cb_settings.colors.accent
  if cb_accent != blank
   assign byob_accent = cb_accent
  endif
  assign cb_accent_light = cb_settings.colors.accentLight
  if cb_accent_light != blank
   assign byob_accent_light = cb_accent_light
  endif
  assign cb_bg = cb_settings.colors.background
  if cb_bg != blank
   assign byob_bg = cb_bg
  endif
 endif
 assign byob_collection_handle = byob_collection.handle
 assign byob_product_count = byob_collection.products_count
%}
<style>
  #byob-block-{{ block.id }},
 #byob-bottom-bar-{{ block.id }} {
  --byob-green: {{ byob_accent }};
  --byob-green-light: {{ byob_accent_light }};
  --byob-grey: #D9DCE1;
  --byob-grey-dark: #94A3B8;
  --byob-text: #1E293B;
  --byob-subtext: #64748B;
  --byob-white: {{ byob_bg }};
  --byob-orange-bg: #FFF3E0;
  --byob-orange-text: #C2410C;
  --byob-card-border: #E2E8F0;
 }
 .byob-section {
  max-width: {{ block.settings.container_width }}px;
  margin: 0 auto;
  padding: 40px 24px 24px;
  box-sizing: border-box;      width: 100%;
  overflow-x: hidden;        }
 .byob-section h2.byob-heading { font-size: 26px; margin: 0 0 4px; color: var(--byob-text); }
 .byob-section p.byob-sub { color: var(--byob-subtext); margin: 0 0 28px; }
  .byob-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 18px; width: 100%; box-sizing: border-box; }
 .byob-product-card { position: relative; background: var(--byob-white); border: 1px solid var(--byob-card-border); border-radius: 10px; padding: 14px; display: flex; flex-direction: column; gap: 8px; transition: border-color 0.2s ease, box-shadow 0.2s ease, opacity 0.2s ease; }
 .byob-product-card:hover { box-shadow: 0 4px 14px rgba(15, 23, 42, 0.08); }
  .byob-product-card { cursor: pointer; }
 .byob-product-card .byob-add-btn { cursor: pointer; }
 .byob-product-card:focus-visible { outline: 2px solid var(--byob-green); outline-offset: 2px; }
 .byob-product-card.byob-card-soldout, .byob-product-card.byob-card-disabled { cursor: default; }  .byob-product-image { position: relative; z-index: 1; width: 100%; aspect-ratio: 1 / 1; border-radius: 8px; overflow: hidden; background: #F1F5F9; }
 .byob-product-image img { width: 100%; height: 100%; object-fit: cover; display: block; transition: filter 0.2s ease, opacity 0.2s ease; }
 .byob-product-title { font-size: 13.5px; font-weight: 600; line-height: 1.3; min-height: 34px; color: var(--byob-text); transition: opacity 0.2s ease; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
 .byob-product-price { font-size: 14px; font-weight: 700; color: var(--byob-text); transition: opacity 0.2s ease; }
  .byob-areviews-source { position: absolute; width: 1px; height: 1px; overflow: hidden; opacity: 0.01; pointer-events: none; }
 .byob-add-btn { margin-top: 2px; width: 100%; padding: 9px 10px; border-radius: 6px; border: 1px solid var(--byob-card-border); background: var(--byob-white); font-size: 12.5px; font-weight: 700; cursor: pointer; transition: all 0.18s ease; color: var(--byob-text); }
 .byob-add-btn:hover { border-color: var(--byob-green); color: var(--byob-green); }
 .byob-product-card.byob-card-selected { border-color: var(--byob-green); border-width: 0.8px; background: var(--byob-green-light); box-shadow: 0 0 0 3px color-mix(in srgb, var(--byob-green) 12%, transparent), 0 4px 12px color-mix(in srgb, var(--byob-green) 10%, transparent); }
 .byob-product-card.byob-card-selected .byob-add-btn { background: var(--byob-green); border-color: var(--byob-green); color: #fff; }
 .byob-selected-check { position: absolute; top: 8px; right: 8px; z-index: 5; width: 32px; height: 32px; border-radius: 50%; background: var(--byob-green); color: #fff; display: none; align-items: center; justify-content: center; font-size: 18px; font-weight: 700; box-shadow: 0 3px 8px color-mix(in srgb, var(--byob-green) 45%, transparent); pointer-events: none; }
 .byob-product-card.byob-card-selected .byob-selected-check { display: flex; }
 .byob-product-card.byob-card-disabled { opacity: 0.5; pointer-events: none; }
 .byob-product-card.byob-card-disabled .byob-add-btn { background: #F1F5F9; color: var(--byob-grey-dark); border-color: var(--byob-card-border); cursor: not-allowed; }
 .byob-product-card.byob-card-soldout .byob-add-btn { background: #F1F5F9; color: var(--byob-grey-dark); cursor: not-allowed; }
  .byob-modal-overlay { display: none; position: fixed; inset: 0; z-index: 10000; background: rgba(15, 23, 42, 0.55); padding: 20px; align-items: center; justify-content: center; }
 .byob-modal-overlay.byob-modal-open { display: flex; }
 body.byob-modal-locked { overflow: hidden; }
  .byob-modal { position: relative; background: var(--byob-white); border-radius: 18px; width: 100%; max-width: 980px; max-height: 90vh; display: flex; align-items: stretch; overflow: hidden; box-shadow: 0 24px 70px rgba(15, 23, 42, 0.32); }
 .byob-modal-close { position: absolute; top: 14px; right: 14px; z-index: 5; width: 38px; height: 38px; border-radius: 50%; border: 1px solid var(--byob-card-border); background: #fff; color: var(--byob-text); font-size: 20px; line-height: 1; cursor: pointer; display: flex; align-items: center; justify-content: center; box-shadow: 0 3px 10px rgba(15, 23, 42, 0.16); transition: color 0.15s ease, transform 0.15s ease; }
 .byob-modal-close:hover { color: var(--byob-green); transform: scale(1.05); }
  .byob-modal-media { flex: 0 0 51%; max-width: 51%; box-sizing: border-box; overflow-y: auto; display: flex; flex-direction: column; gap: 12px; padding: 24px; }
 .byob-modal-carousel { position: relative; background: #F1F5F9; border-radius: 12px; overflow: hidden; }
 .byob-modal-carousel-track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
 .byob-modal-carousel-track::-webkit-scrollbar { display: none; }
 .byob-modal-carousel-slide { flex: 0 0 100%; scroll-snap-align: start; aspect-ratio: 1 / 1; }
 .byob-modal-carousel-slide img { width: 100%; height: 100%; object-fit: cover; display: block; }
 .byob-modal-carousel-arrow { position: absolute; top: 50%; transform: translateY(-50%); width: 32px; height: 32px; border-radius: 50%; border: none; background: rgba(255, 255, 255, 0.92); color: var(--byob-text); font-size: 18px; line-height: 1; cursor: pointer; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(15, 23, 42, 0.22); }
 .byob-modal-carousel-arrow:hover { color: var(--byob-green); }
 .byob-modal-carousel-arrow[hidden] { display: none; }
 .byob-modal-carousel-prev { left: 10px; }
 .byob-modal-carousel-next { right: 10px; }
  .byob-modal-thumbs { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; }
 .byob-modal-thumbs::-webkit-scrollbar { display: none; }
 .byob-modal-thumbs[hidden] { display: none; }
 .byob-modal-thumb { flex: 0 0 auto; width: 60px; height: 60px; border-radius: 8px; overflow: hidden; background: #F1F5F9; border: 2px solid transparent; padding: 0; cursor: pointer; transition: border-color 0.15s ease; }
 .byob-modal-thumb.is-active { border-color: var(--byob-green); }
 .byob-modal-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .byob-modal-reviews-card { background: var(--byob-green-light); border-radius: 12px; padding: 14px 16px 16px; }
 .byob-modal-reviews-card[hidden] { display: none; }
 .byob-modal-reviews-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 10px; }
 .byob-modal-reviews-title { font-size: 14px; font-weight: 800; color: var(--byob-text); }
 .byob-modal-reviews-seeall { font-size: 12px; font-weight: 700; color: var(--byob-green); text-decoration: none; white-space: nowrap; }
 .byob-modal-reviews-seeall:hover { text-decoration: underline; }
 .byob-modal-reviews-carousel { display: flex; align-items: center; gap: 8px; }
 .byob-modal-reviews-arrow { flex-shrink: 0; width: 30px; height: 30px; border-radius: 50%; border: none; background: #fff; color: var(--byob-text); font-size: 16px; line-height: 1; cursor: pointer; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(15, 23, 42, 0.15); }
 .byob-modal-reviews-arrow:hover { color: var(--byob-green); }
 .byob-modal-reviews-arrow[hidden] { display: none; }
 .byob-modal-reviews-track { flex: 1 1 auto; min-width: 0; background: #fff; border-radius: 10px; padding: 12px 14px; }
  .byob-modal-review-slide { display: none; flex-direction: column; }
 .byob-modal-review-slide.is-active { display: flex; }
 .byob-modal-review-slide .comment_container { order: 1; }
 .byob-modal-review-slide .comment { font-size: 12.5px; line-height: 1.5; color: var(--byob-text); margin: 0; }
 .byob-modal-review-slide .areviews_hide_long_reviews { display: none; }
