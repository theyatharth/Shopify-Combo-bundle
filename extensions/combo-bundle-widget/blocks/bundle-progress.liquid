 }
 @media screen and (max-width: 768px) {
  .byob-modal-overlay { padding: 0; align-items: flex-end; }
  .byob-modal { flex-direction: column; max-width: 100%; max-height: 92vh; border-radius: 18px 18px 0 0; overflow-y: auto; }
