 .byob-modal-areviews-avg { font-weight: 700; color: var(--byob-text); margin: 0 4px; font-size: 12.5px; }
  .byob-modal-body { flex: 1 1 49%; max-width: 49%; box-sizing: border-box; overflow-y: auto; display: flex; flex-direction: column; padding: 28px 26px 26px 20px; min-width: 0; }
 .byob-modal-title { font-size: 20px; font-weight: 700; line-height: 1.3; color: var(--byob-text); margin: 0 0 8px; padding-right: 30px; }
 .byob-modal-price-row { display: flex; align-items: baseline; flex-wrap: wrap; gap: 8px 10px; margin: 6px 0 14px; }
 .byob-modal-price { font-size: 22px; font-weight: 800; color: var(--byob-text); }
 .byob-modal-compare-price { font-size: 15px; font-weight: 500; color: var(--byob-grey-dark); text-decoration: line-through; }
 .byob-modal-compare-price[hidden], .byob-modal-discount-badge[hidden] { display: none; }
 .byob-modal-discount-badge { background: var(--byob-green-light); color: var(--byob-green); font-size: 12px; font-weight: 800; padding: 3px 10px; border-radius: 999px; }
 .byob-modal-desc-wrap { margin-bottom: 18px; }
  .byob-modal-desc { font-size: 13.5px; line-height: 1.6; color: var(--byob-subtext); margin: 0; word-break: break-word; }
 .byob-modal-desc.is-clamped { display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
