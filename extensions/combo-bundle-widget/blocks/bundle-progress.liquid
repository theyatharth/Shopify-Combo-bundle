  .byob-modal-carousel { border-radius: 10px; }
  .byob-modal-carousel-slide { aspect-ratio: 1 / 1; }
  .byob-modal-thumb { width: 50px; height: 50px; }
  .byob-modal-body { padding: 4px 18px 90px; }
  .byob-modal-title { font-size: 18px; padding-right: 34px; }
  .byob-modal-price { font-size: 19px; }
  .byob-modal-qty-label, .byob-modal-qty-note { display: none; }
  .byob-modal-actions-row { position: fixed; left: 0; right: 0; bottom: 0; z-index: 9999; background: #fff; padding: 12px 16px calc(12px + env(safe-area-inset-bottom, 0px)); box-shadow: 0 -4px 16px rgba(15, 23, 42, 0.12); margin-bottom: 0; }
 }
  #byob-bottom-bar-{{ block.id }} {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  width: 100%;
